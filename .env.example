# 실측 지도 만들기(python -m server.realdata.build)에 쓰는 인증키.
# 이 파일을 .env 로 복사해 값을 채운다. .env는 git에 올리지 않는다(.gitignore).

# 공공데이터포털 https://www.data.go.kr 일반 인증키(Decoding). 키 하나로 아래 두 API를 함께 쓴다.
# 활용신청 필요: 농촌진흥청 국립농업과학원_토양도 기반 토양특성 상세 정보 V3(15144225), 토양특성 단면정보 V2(15144105)
DATA_GO_KR_KEY=

# 브이월드 https://www.vworld.kr 오픈API 인증키(2D 데이터 API)와 발급 때 적은 서비스 URL
VWORLD_KEY=
VWORLD_DOMAIN=http://localhost
